{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/wiki/",
      "destination": "/wiki",
      "statusCode": 301
    },
    {
      "source": "/wiki/:id/",
      "destination": "/wiki/:id",
      "statusCode": 301
    },
    {
      "source": "/v/:id/",
      "destination": "/v/:id",
      "statusCode": 301
    },
    {
      "source": "/video/:id/",
      "destination": "/v/:id",
      "statusCode": 301
    },
    {
      "source": "/b/:id/",
      "destination": "/b/:id",
      "statusCode": 301
    },
    {
      "source": "/blog/:id/",
      "destination": "/b/:id",
      "statusCode": 301
    },
    {
      "source": "/autores/:id/",
      "destination": "/autores/:id",
      "statusCode": 301
    },
    {
      "source": "/temas/:id/",
      "destination": "/temas/:id",
      "statusCode": 301
    },
    {
      "source": "/podcast/",
      "destination": "/podcast",
      "statusCode": 301
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?route=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?route=robots"
    },
    {
      "source": "/v/:id/thumb.jpg",
      "destination": "/api/index?route=video/thumb&id=:id"
    },
    {
      "source": "/video/:id/thumb.jpg",
      "destination": "/api/index?route=video/thumb&id=:id"
    },
    {
      "source": "/v/:id",
      "destination": "/api/index?route=preview&type=video&id=:id"
    },
    {
      "source": "/video/:id",
      "destination": "/api/index?route=preview&type=video&id=:id"
    },
    {
      "source": "/b/:id/image",
      "destination": "/api/index?route=post/image&slug=:id"
    },
    {
      "source": "/blog/:id/image",
      "destination": "/api/index?route=post/image&slug=:id"
    },
    {
      "source": "/b/:id",
      "destination": "/api/index?route=preview&type=blog&id=:id"
    },
    {
      "source": "/blog/:id",
      "destination": "/api/index?route=preview&type=blog&id=:id"
    },
    {
      "source": "/podcast",
      "destination": "/api/index?route=preview&type=catalog"
    },
    {
      "source": "/blog",
      "destination": "/api/index?route=preview&type=bloghub"
    },
    {
      "source": "/autores/:id",
      "destination": "/api/index?route=preview&type=author&id=:id"
    },
    {
      "source": "/temas/:id",
      "destination": "/api/index?route=preview&type=topic&id=:id"
    },
    {
      "source": "/wiki/:id",
      "destination": "/api/index?route=preview&type=wiki&id=:id"
    },
    {
      "source": "/wiki",
      "destination": "/api/index?route=preview&type=wiki"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/api/index?route=preview&notfound=1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://odysee.com https://player.vimeo.com https://www.dailymotion.com https://rumble.com https://accounts.google.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://accounts.google.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}